# --- Ficheros temporales de trabajo (descargas intermedias, NO versionar) ---
data/raw/_*
data/raw/*.zip
data/**/_opl_completo.csv
*.tmp

# --- Documentos de trabajo interno, no forman parte de la entrega ---
docs/ESTADO.md

# Scripts auxiliares que sirvieron para cargar las medidas en el modelo.
# Se conservan en local por si hubiera que rehacerlo, pero no aportan nada
# a la entrega: las medidas quedan documentadas en dashboard/medidas.dax.
dashboard/medidas_tmdl.txt
dashboard/script_tmdl_completo.txt
dashboard/script_tmdl_paso1.txt

# --- Datos derivados voluminosos: se generan, no se versionan ---
# La version versionada del conjunto final es el .csv.gz (83 MB), que si se
# sube. Lo siguiente se reconstruye con los scripts de src/ y superaria el
# limite de 100 MB por fichero de GitHub.

# Conjunto final sin comprimir (139 MB) -> python src/transformacion.py
data/processed/dataset_final_powerlifting_femenino.csv

# Base de datos SQLite (357 MB con indices) -> python src/base_datos.py
sql/*.db
sql/*.db-journal
sql/*.sqlite

# Tablas exportadas para Power BI -> python src/exportar_powerbi.py
# Son datos derivados del conjunto final, que si esta versionado.
dashboard/datos/*.csv
dashboard/datos/*.parquet

